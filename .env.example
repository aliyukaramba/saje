# Copy to .env (never commit real values). Separate values per environment.
# Environments: development (branch dev) and production (branch main).
APP_ENV=development
RESTAURANT_NAME="Restaurant Name"
PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (use a Hyperdrive connection string on Cloudflare; see docs/DEPLOYMENT.md)
DATABASE_URL=postgresql://user:password@localhost:5432/restaurant_dev

# Auth
SESSION_SECRET=change-me-to-64-random-bytes

# Topify (server-only). Credentials and exact field names are pending; see docs/PHASE_STATUS.md
TOPIFY_SECRET_KEY=
TOPIFY_WEBHOOK_SECRET=

# Cloudflare R2 (images and uploads)
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
