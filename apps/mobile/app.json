{
  "expo": {
    "name": "Saje",
    "slug": "saje",
    "scheme": "saje",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f2f2f4",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saje.customer",
      "associatedDomains": [
        "applinks:saje-web.akarambaaleeyu.workers.dev"
      ]
    },
    "android": {
      "package": "com.saje.customer",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "saje-web.akarambaaleeyu.workers.dev",
              "pathPrefix": "/t/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SAJE to use your camera to scan restaurant table QR codes."
        }
      ],
      "expo-notifications"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2f2f4"
    }
  }
}
