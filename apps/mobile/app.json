{
  "expo": {
    "name": "Saje",
    "slug": "saje",
    "scheme": "saje",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f2f2f4",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saje.customer"
    },
    "android": {
      "package": "com.saje.customer"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SAJE to use your camera to scan restaurant table QR codes."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2f2f4"
    }
  }
}
