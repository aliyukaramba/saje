{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saje-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "saje-media"
    }
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://pub-d0f1af6f3f444f60820ce13618fe3331.r2.dev"
  },
  "env": {
    "staging": {
      "name": "saje-web-staging",
      "main": ".open-next/worker.js",
      "compatibility_date": "2025-05-05",
      "compatibility_flags": [
        "nodejs_compat",
        "nodejs_compat_populate_process_env"
      ],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": {
        "enabled": true
      },
      "vars": {}
    }
  }
}
